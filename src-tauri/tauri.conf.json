{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tax Calculator",
  "version": "0.1.5",
  "identifier": "com.supun.tax-calculator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tax Calculator",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyODk4RkRFNjZCOTIzRDQKUldUVUk3bG0zbytKa3FvWmlPU3RkR1phK0UxRHJRRlJNekRpa1VVQ2VoUnlIMjM0azBxWUZiS3IK",
      "endpoints": [
        "https://github.com/Supun-SD/Tax-Calculator/releases/latest/download/latest.json"
      ]
    }
  }
}